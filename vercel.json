{
  "cleanUrls": true,
  "functions": { "api/claude.js": { "maxDuration": 60 }, "api/render.js": { "maxDuration": 60 } },
  "headers": [
    { "source": "/img/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
    { "source": "/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] }
  ]
}
